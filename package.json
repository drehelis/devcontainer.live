{
  "name": "devcontainer-generator",
  "private": true,
  "version": "1.0.26",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format:write": "prettier --write src/",
    "format:check": "prettier --check src/",
    "type-check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@types/lz-string": "^1.3.34",
    "js-yaml": "^5.0.0",
    "jszip": "^3.10.2",
    "lz-string": "^1.5.0",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
